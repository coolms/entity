{
    "name": "coolms/entity",
    "description": "Entity contracts for the CoolMS platform: the extras (dynamic per-entity fields) engine and its ports, alias registry, entity resolvers, virtual fields and the shared provider traits",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "coolms",
        "entity",
        "extras",
        "dynamic-fields",
        "schema"
    ],
    "authors": [
        {
            "name": "Dmitry Popov"
        }
    ],
    "require": {
        "php": "^8.5",
        "coolms/core": "^2.0",
        "coolms/rql": "^1.0",
        "symfony/property-access": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "CoolMS\\Entity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoolMS\\Entity\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
